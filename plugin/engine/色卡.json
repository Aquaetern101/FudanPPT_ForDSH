  "rules": {
    "slot_semantics": {
      "1": "主色", "2": "次色", "3": "浅底（广义白，作背景/填充）",
      "4": "第三色（对比用）", "5": "深字（广义黑，作文字/描边）"
    },
    "contrast": {
      "when": "柱状图等依赖色彩区分的图，且分类数 >= 4",
      "pick": "按系顺序、系内 1→2→4 位抽取，跨系循环",
      "example": "4 类：R1-1, R1-2, R1-4, R2-1；6 类：R1-1, R1-2, R1-4, R2-1, R2-2, R2-4"
    },
    "monochrome": {
      "when": "不强调对比，或分类数 < 4",
      "pick": "同一系内顺序调用 1→2→4→3→5",
      "constraint": "3 位与 5 位（白/黑）不得直接相邻使用"
    },
    "reserve": { "3": "不用于数据系列", "5": "不用于大面积填充" }
  }
